# Copy to .env.local and fill in. Never commit the real file.

# Required: job search (LinkedIn) and hiring-contact lookup (Apollo), via Monid. https://monid.ai
MONID_API_KEY=

# Required for email approvals and applying: Agent37 sk_live_ key. https://agent37.com
AGENT37_API_KEY=

# LLM: OpenAI is tried first, Gemini is the fallback. Set at least one.
OPENAI_API_KEY=
# Optional, defaults to gpt-5.4-mini
OPENAI_MODEL=
GEMINI_API_KEY=

# Required in production: signs session cookies and 72h approval links. Any long random string.
AUTH_SECRET=

# Public URL of the app, used in approval emails (e.g. https://ocus-ai.vercel.app; locally http://localhost:3000).
APP_URL=

# Storage, picked in this order. Leave both empty to use a local JSON file (.data/db.json).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
